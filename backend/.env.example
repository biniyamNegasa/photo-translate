# Copy this file to `backend/.env` and restrict permissions (`chmod 600 backend/.env`).
# Google Translate works out of the box with no API key required.

# --- Security & Access Control ---
# Optional shared API key required in `X-API-Key` / `Authorization: Bearer <key>` when set.
# Strongly recommended whenever the backend is reachable beyond localhost.
PHOTO_TRANSLATE_API_KEY=

# Allowed browser origins for CORS (JSON array or comma-separated list).
# Defaults to local development origins only. Set explicit production origins when deployed.
PHOTO_TRANSLATE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Expose OpenAPI / Swagger UI (/docs, /redoc, /openapi.json). Set to false in production.
PHOTO_TRANSLATE_ENABLE_DOCS=false

# --- Translation APIs (all optional) ---
# DeepSeek (recommended for Japanese/Chinese manga, idioms & context-aware batch translation)
PHOTO_TRANSLATE_DEEPSEEK_API_KEY=
PHOTO_TRANSLATE_DEEPSEEK_MODEL=deepseek-chat
PHOTO_TRANSLATE_DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# Addis AI (specialized for Amharic, Afaan Oromo, Tigrinya, Swahili, English)
PHOTO_TRANSLATE_ADDIS_API_KEY=
PHOTO_TRANSLATE_ADDIS_API_URL=https://api.addisassistant.com/api/v1/translate

# DeepL API (free or pro endpoint)
PHOTO_TRANSLATE_DEEPL_API_KEY=
PHOTO_TRANSLATE_DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# --- Runtime & Batch Tuning ---
PHOTO_TRANSLATE_JOB_TTL_SECONDS=3600
PHOTO_TRANSLATE_MAX_UPLOAD_MB=100
PHOTO_TRANSLATE_MAX_BATCH_IMAGES=100
PHOTO_TRANSLATE_WORKER_CONCURRENCY=2
PHOTO_TRANSLATE_ITEM_CONCURRENCY=3
PHOTO_TRANSLATE_BUBBLE_OCR_CONCURRENCY=4
